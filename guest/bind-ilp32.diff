+ */
+static isc_mutex_t stats_mutex = PTHREAD_MUTEX_INITIALIZER;
+#define ISC_STATS_INIT(p, v) (*(p) = (v))
+#define ISC_STATS_GET(p) \
+	({ \
+		isc_mutex_lock(&stats_mutex); \
+		uint64_t x = *(p); \
+		isc_mutex_unlock(&stats_mutex); \
+		x; \
+	})
+#define ISC_STATS_SET(p, v) \
+	({ \
+		isc_mutex_lock(&stats_mutex); \
+		*(p) = (v); \
+		isc_mutex_unlock(&stats_mutex); \
+	})
+#define ISC_STATS_ADD(p, v) \
+	({ \
+		isc_mutex_lock(&stats_mutex); \
+		uint64_t x = *(p); \
+		*(p) = x + (v); \
+		isc_mutex_unlock(&stats_mutex); \
+		x; \
+	})
+#define ISC_STATS_SUB(p, v) \
+	({ \
+		isc_mutex_lock(&stats_mutex); \
+		uint64_t x = *(p); \
+		*(p) = x - (v); \
+		isc_mutex_unlock(&stats_mutex); \
+		x; \
+	})
+#endif
+
